<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Bluetooth, for the Leica DISTO laser meter. We connect to an
         already-bonded device (no scan), so no location / BLUETOOTH_SCAN is
         needed. BLUETOOTH_CONNECT is a runtime permission on API 31+ (requested
         in MainActivity); the legacy BLUETOOTH covers API 30. Storage is still
         internal-only. -->
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-feature android:name="android.hardware.bluetooth_le"
        android:required="false" />

    <!-- Voice notes: record audio via MediaRecorder (runtime permission,
         requested in MainActivity). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Networking: the bug-report uploader and cloud sync need internet, and
         the connectivity callback (fires nativeOnNetworkUp when WiFi returns)
         needs network-state access. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- In-app photos: CameraActivity captures via CameraX (with an app-owned
         flash toggle) instead of handing off to the system camera app, so we
         hold the CAMERA permission ourselves (requested at runtime in
         CameraActivity). The capture is written to our private cache dir, so no
         storage permission / FileProvider is needed. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any"
        android:required="false" />

    <application
        android:label="BER App">
        <!-- eframe runs via android-activity's native-activity glue:
             NativeActivity loads libber_app.so (the cdylib built by
             cargo-ndk into jniLibs/) and calls its android_main. MainActivity
             is a thin NativeActivity subclass that adds immersive mode (hides
             the system bars so they don't overlap the app's bottom panels);
             the APK therefore carries a DEX, so no android:hasCode="false". -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen"
            android:screenOrientation="sensor"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|screenLayout|uiMode">
            <meta-data
                android:name="android.app.lib_name"
                android:value="ber_app" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- In-app CameraX capture screen, launched for-result by MainActivity's
             requestPhoto(). Not exported (internal to the app). Locked to the
             sensor orientation like the main activity. -->
        <activity
            android:name=".CameraActivity"
            android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen"
            android:screenOrientation="sensor"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|screenLayout|uiMode" />
    </application>

</manifest>
