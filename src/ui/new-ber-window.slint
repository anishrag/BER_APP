import { Button, VerticalBox, HorizontalBox } from "std-widgets.slint";
import { PageBase } from "./page-base.slint";

export component NewBERWindow inherits PageBase {
    callback next(string, string, string, string, string, string);
    
    // Properties to store input values
    in-out property <string> name_text;
    in-out property <string> email_text;
    in-out property <string> address_text;
    in-out property <string> eircode_text;
    in-out property <string> fee_text;
    in-out property <string> house_type_text;
    VerticalLayout {
        spacing: 8px;
        padding: 16px;
        Text {
            text: "New BER Assessment";
            font-size: 20px;
        }

        Text {
            text: "Name:";
        }

        TextInput {
            text <=> root.name_text;
        }

        Text {
            text: "Email:";
        }

        TextInput {
            text <=> root.email_text;
        }

        Text {
            text: "Address:";
        }

        TextInput {
            text <=> root.address_text;
        }

        Text {
            text: "Eircode:";
        }

        TextInput {
            text <=> root.eircode_text;
        }

        Text {
            text: "Fee:";
        }

        TextInput {
            text <=> root.fee_text;
        }

        Text {
            text: "House Type:";
        }

        TextInput {
            text <=> root.house_type_text;
        }

        Rectangle {
            // Spacer
            vertical-stretch: 1;
        }

        Rectangle {
            height: 40px;
            background: #0d6efd;
            border-radius: 4px;
            Text {
                text: "Next";
                color: white;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            TouchArea {
                clicked => {
                    root.next(
                        root.name_text,
                        root.email_text,
                        root.address_text,
                        root.eircode_text,
                        root.fee_text,
                        root.house_type_text);
                }
            }
        }
    }
}
