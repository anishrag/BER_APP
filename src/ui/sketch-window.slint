import { VerticalBox, Button } from "std-widgets.slint";
import { PageBase } from "./page-base.slint";

component DrawingCanvas inherits Rectangle {
      in property <image> canvas_image;

    callback drawing_event(string);

    Rectangle {
        width: parent.width;
        height: parent.height;

        Image {
            source: root.canvas_image;
            width: parent.width;
            height: parent.height;
        }

        TouchArea {
            width: parent.width;
            height: parent.height;

            pointer-event(e) => {
                if (e.kind == PointerEventKind.down) {
                    root.drawing_event("stroke_start:" + self.mouse-x/1px + "," + self.mouse-y/1px);
                } else if (e.kind == PointerEventKind.move && e.button == PointerEventButton.left) {
                    root.drawing_event("stroke_move:" + self.mouse-x/1px + "," + self.mouse-y/1px);
                } else if (e.kind == PointerEventKind.up) {
                    root.drawing_event("stroke_end");
                }
            }
        }
    }

  }
export component SketchWindow inherits PageBase {
    callback next();
        // Form fields
        VerticalBox {
            spacing: 8px;

    DrawingCanvas {
        width: parent.width - 100px;
        height: parent.height - 100px;

    }


        // Bottom Next button
        Button {
            text: "Next";
            clicked => { root.next(); }
        }

    }
}

